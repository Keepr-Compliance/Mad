# The android-companion dependency tree (expo canary + @sentry/react-native)
# has peer-dependency conflicts that npm v7+ strict resolution rejects. The
# lockfile is generated with legacy (npm v6) peer resolution — the same mode
# scripts/build-apk.sh uses via `npm install --legacy-peer-deps`. Setting it
# here makes plain `npm ci` / `npm install` reproducible for local devs and CI
# (BACKLOG-2221 added a CI job that runs `npm ci`).
legacy-peer-deps=true

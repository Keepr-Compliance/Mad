{
  "expo": {
    "name": "Keepr Companion",
    "slug": "keepr-companion",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "keepr-companion",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.keepr.companion",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#574CE8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withLanCleartext",
      "expo-router",
      "expo-task-manager",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Keepr Companion to access your contacts to sync them with the desktop app."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "barStyle": "dark"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "keeprcompliancecom",
          "project": "electron",
          "url": "https://us.sentry.io"
        }
      ]
    ]
  }
}

{
  "manifest_version": 3,
  "name": "Keepr for Google Messages",
  "version": "0.3.44",
  "description": "Copies your Google Messages texts to the Keepr desktop app when you start a Sync in Keepr.",
  "icons": {
    "16": "icons/keepr-16.png",
    "32": "icons/keepr-32.png",
    "48": "icons/keepr-48.png",
    "128": "icons/keepr-128.png"
  },
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Keepr",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/keepr-16.png",
      "32": "icons/keepr-32.png",
      "48": "icons/keepr-48.png",
      "128": "icons/keepr-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://messages.google.com/*",
    "http://127.0.0.1:38619/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://messages.google.com/web/*"
      ],
      "js": [
        "extract.js",
        "scan.js",
        "job.js",
        "eyes.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-eye": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Sync on/off for the selected chat (Keepr's eye)"
    }
  }
}

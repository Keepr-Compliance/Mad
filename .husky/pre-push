#!/bin/sh
#
# pre-push: run the tests affected by THE COMMITS BEING PUSHED.
# Blocks the push if those tests fail. (BACKLOG-2573)
#
# ## The two defects this replaced
#
# 1. WRONG BASE. The old hook read `@{upstream}` and fell back to
#    `origin/develop` when a branch had no upstream -- i.e. on every first
#    push. From a branch cut off `int/email-retention` (measured: 214 commits /
#    517 files ahead of develop) that selected 230 suites to guard a 6-file
#    diff, so every push needed `--no-verify`. A hook that is always bypassed
#    is not a hook.
#
#    The fix is not a better two-point diff -- a two-point diff regenerates the
#    bug the moment a branch sync-merges its base branch (CLAUDE.md Step 4
#    mandates exactly that), because one endpoint then sits before the whole
#    int advance. The fix is to bound the file set by the COMMITS being pushed:
#      git log --name-only --pretty=format: "$local_sha" --not --remotes="$remote"
#    That also handles multi-boundary history, force-push-after-rebase and
#    multi-ref pushes natively, and needs no upstream and no `remote_sha`.
#
#    `--cc` was evaluated and not adopted: measured identical (3 files vs 3) on
#    a real sync-merge branch, so it buys nothing on this repo's history.
#    Consequence, accepted: a conflict resolution that exists ONLY inside a
#    merge commit contributes no files here. CI still covers it.
#
# 2. WRONG ABI. `better-sqlite3-multiple-ciphers` compiles for one ABI at a
#    time and rests on the Electron build. 32 suites bypass the jest
#    moduleNameMapper stub and load the REAL binary; under plain-node jest they
#    load fine and then fail inside the tests at `new Database(...)`, on every
#    branch, regardless of the diff. So the condition cannot be detected by
#    trying to load a suite -- this hook probes THE BINARY and picks the runner
#    that matches it.
#
#    NEVER rebuild the module here. Every git worktree symlinks node_modules at
#    the main repo, so a rebuild from a hook breaks the founder's running dev
#    app and every sibling worktree at once. See scripts/test-with-restore.js.
#
# ## Knobs (all optional; each exists so a control can be RUN, not argued)
#
#   PREPUSH_BASE=<rev>          select commits reachable from the pushed tip but
#                               not from <rev>. Escape hatch -- narrower and
#                               louder than --no-verify.
#   PREPUSH_JEST_ROUTE=auto|node|electron   force the root-jest runner.
#   PREPUSH_ELECTRON_BIN=<path>             override electron resolution.
#   PREPUSH_DRYRUN=1            echo remote / commit count / base / route /
#                               selected suites and the test-type-check decision,
#                               then exit 0 before any runner.
#   PREPUSH_SKIP_PII=1          skip the PII scan. Announces itself loudly.
#                               ONLY for untracked scratch files unrelated to
#                               what is being pushed. Never to get past a real
#                               finding: this repo is PUBLIC and a pushed
#                               commit cannot be unpublished.
#
# ## Shell notes
#
# husky runs this as `sh -e` (.husky/_/h). Every command whose non-zero exit is
# EXPECTED must be guarded with `|| true` or sit in an `if`, or the hook dies
# mid-run. The runner calls use `|| exit_code=$?` so the hook can print its own
# verdict; without that guard `set -e` aborts at the failing runner and the
# "Push blocked" line never prints. The later stages stay skipped either way --
# they gate on `[ $exit_code -eq 0 ]` (lines 109 / 117 / 133 of the pre-2573
# file).

banner() {
  echo ""
  echo "!! ------------------------------------------------------------------"
  echo "!! [pre-push] $1"
  echo "!! ------------------------------------------------------------------"
  shift
  for line in "$@"; do echo "!! $line"; done
  echo ""
}

# A zero-oid is all '0' (40 chars for sha1, 64 for sha256). Any non-'0'
# character means a real oid, so this needs no length literal.
is_zero() {
  case "$1" in
    *[!0]*) return 1 ;;
    "") return 1 ;;
    *) return 0 ;;
  esac
}

repo_root=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")

# --- Remote validation -------------------------------------------------------
# $1 is the remote NAME only when a named remote was used; `git push <url> ...`
# passes a URL. A bogus value made the old derivation silently select nothing
# (measured: 6756 unpushed commits, 0 boundaries -> exit 0) and makes the new
# one select everything (measured: 5025 files). Neither is acceptable, so the
# remote is validated before it is used.
remote="${1:-origin}"
wide_fallback=""
if ! git remote 2>/dev/null | grep -qx "$remote"; then
  if git remote 2>/dev/null | grep -qx "origin"; then
    banner "'$remote' is not a configured remote (a URL was pushed to, or the remote is named differently)." \
           "Falling back to 'origin' for change detection. Test selection may be wider than usual."
    remote="origin"
  else
    banner "No usable remote for change detection: this repository has no configured remote to compare against (looked for '$remote' and 'origin')." \
           "Falling back to a WIDE base. This runs many more suites than a normal push." \
           "Set PREPUSH_BASE=<rev> to narrow it."
    wide_fallback="1"
  fi
fi

# --- What to exclude ---------------------------------------------------------
# PREPUSH_BASE is the sanctioned escape hatch now that --no-verify is frozen, so
# it is the knob engineers actually reach for -- and an unvalidated one is worse
# than no knob at all: `git rev-list --count ... --not <typo>` fails, the
# `|| echo 0` guard below turns that into n=0, and the hook reports the
# reassuring "no new commits" while running ZERO tests. A typo would silently
# disable the hook, which is the disease this file exists to cure. So validate
# it, and on failure IGNORE it rather than honour it: unlike the no-remote case
# below, a working default exists here, so real coverage beats an exit-0 warning.
prepush_base="$PREPUSH_BASE"
if [ -n "$prepush_base" ] && ! git rev-parse --verify --quiet "$prepush_base" >/dev/null 2>&1; then
  banner "PREPUSH_BASE='$prepush_base' does not resolve to anything in this repository." \
         "IGNORING the override -- falling back to normal change detection." \
         "Nothing was skipped: the affected tests below still ran. But if you" \
         "meant to narrow the base, the ref name is wrong. Check it with:" \
         "  git rev-parse --verify $prepush_base"
  prepush_base=""
fi

# One token, used as: git log ... --not $not_arg
if [ -n "$prepush_base" ]; then
  not_arg="$prepush_base"
  base_desc="PREPUSH_BASE=$prepush_base (override)"
  banner "PREPUSH_BASE is set -- change detection is overridden." \
         "Base: $prepush_base" \
         "Unset it to return to normal (commits not yet on '$remote')."
elif [ -n "$wide_fallback" ]; then
  # The wide fallback is only wide if its ref exists. If it does not, every
  # `git rev-list --count` below returns 0 via its `|| echo 0` guard, and the
  # hook would report "no new commits" -- indistinguishable from a genuinely
  # up-to-date push. That is the exact conflation this hook must not make, so
  # the unresolvable case gets its own name and its own banner.
  if git rev-parse --verify --quiet origin/develop >/dev/null 2>&1; then
    not_arg="origin/develop"
    base_desc="origin/develop (wide fallback -- no usable remote)"
  else
    banner "Cannot work out what this push contains: no usable remote, and 'origin/develop' does not exist either." \
           "NO TESTS WERE SELECTED -- this hook checked nothing." \
           "This is NOT a passing test run. CI remains the gate." \
           "To get local coverage, set PREPUSH_BASE=<rev> to something this repo has."
    exit 0
  fi
else
  not_arg="--remotes=$remote"
  base_desc="commits not present on any '$remote' ref"
fi

# --- Collect the pushed commits ----------------------------------------------
# git feeds one line per ref on stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
# `remote_sha` is deliberately unused as a base: excluding every remote ref is
# correct for a first push AND survives a force-push after a rebase, which
# `remote_sha..local_sha` does not.
all_files=""
total_commits=0
saw_ref=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  saw_ref="1"

  if is_zero "$local_sha"; then
    echo "[pre-push] $remote_ref is being deleted -- nothing to test."
    continue
  fi

  n=$(git rev-list --count "$local_sha" --not $not_arg 2>/dev/null || echo 0)
  total_commits=$((total_commits + n))

  if [ "$n" -eq 0 ]; then
    echo "[pre-push] $local_ref: no new commits for '$remote' -- nothing to test."
    continue
  fi

  echo "[pre-push] $local_ref: $n commit(s) to push (base: $base_desc)"
  f=$(git log --name-only --pretty=format: "$local_sha" --not $not_arg 2>/dev/null || true)
  all_files="$all_files
$f"
done

# No stdin at all (hook invoked by hand, or by a caller that does not speak the
# pre-push protocol). Fall back to HEAD through the SAME validated remote and
# the SAME exclusion spec -- never to a hardcoded branch.
if [ -z "$saw_ref" ]; then
  head_sha=$(git rev-parse HEAD 2>/dev/null || true)
  if [ -z "$head_sha" ]; then
    echo "[pre-push] No refs on stdin and no resolvable HEAD -- nothing to test."
    exit 0
  fi
  total_commits=$(git rev-list --count "$head_sha" --not $not_arg 2>/dev/null || echo 0)
  echo "[pre-push] No refs on stdin -- falling back to HEAD ($total_commits commit(s), base: $base_desc)"
  if [ "$total_commits" -gt 0 ]; then
    all_files=$(git log --name-only --pretty=format: "$head_sha" --not $not_arg 2>/dev/null || true)
  fi
fi

# Loud, but never narrowing and never skipping: a plausible push is a handful of
# commits. A three-digit count means the exclusion spec is not doing its job.
if [ "$total_commits" -gt 50 ]; then
  banner "$total_commits commits are being treated as new -- that is unusually many." \
         "Base in use: $base_desc" \
         "Test selection will be much wider than a normal push." \
         "If this is wrong, check the remote name, or set PREPUSH_BASE=<rev>."
fi

# --- PII scan: before ANY early exit, because a push cannot be taken back ----
# (BACKLOG-2725)
#
# `npm run check:pii` ran at ci.yml:221 and nowhere local. This repo is PUBLIC,
# so CI reported exposures only after the commit was already on GitHub and
# unpublishable. Fixing the PR afterwards moves the branch tip; it does not
# remove the object. Hence the open GitHub Support ticket asking them to
# garbage-collect commits from December 2025.
#
# PLACEMENT: above the `changed_files` empty-exit. A merge commit lists no
# files without --cc (measured: 0 on a2a98d540), so a routine sync-merge push
# would otherwise skip the scan entirely. Gated on total_commits so a
# delete-ref or up-to-date push still skips -- nothing to publish there.
#
# THREE LIMITS, written down because a guard whose gaps are unstated gets
# trusted past them:
#   1. INTERMEDIATE COMMITS. This scans the WORKING TREE, not each commit in
#      the pushed range. Fixing a finding in a NEW commit and pushing both
#      still publishes the offending one. That is why the message below says
#      amend/rebase -- do not soften it. It is PR #2314's exact shape.
#   2. UNTRACKED FILES are scanned, so a stray scratch file can block an
#      unrelated push. PREPUSH_SKIP_PII exists for that, and announces itself.
#   3. NUL BYTES. A file containing a raw NUL reads as binary and is skipped
#      SILENTLY (BACKLOG-2657; how contactManualLink.ts hid for weeks,
#      BACKLOG-2637). CI has the same hole, so this does not widen it.
#
# TIME: 1.24-1.31s user, 1.26-1.82s wall, constant regardless of diff size.
# BACKLOG-2573 rewrote this hook because the old one made --no-verify routine
# -- "a hook that is always bypassed is not a hook". If this scan ever grows
# slow enough to train that habit, REMOVE IT.
if [ "$total_commits" -gt 0 ] 2>/dev/null; then
  if [ -n "$PREPUSH_SKIP_PII" ]; then
    banner "PREPUSH_SKIP_PII is set -- the PII scan was SKIPPED." \
           "This repository is PUBLIC and a pushed commit cannot be unpublished." \
           "Only for untracked scratch files unrelated to what you are pushing." \
           "Unset it and re-run before pushing anything you have not read."
  elif ! npm run check:pii --silent; then
    echo ""
    echo "[pre-push] PII scan failed. Push blocked."
    echo "[pre-push] This repository is PUBLIC -- a pushed commit cannot be unpublished."
    echo ""
    echo "[pre-push] AMEND or REBASE the commit that introduced the value."
    echo "[pre-push] Do NOT fix it in a new commit on top: this scan reads the"
    echo "[pre-push] working tree, so a follow-up commit passes while the"
    echo "[pre-push] offending one still publishes. That is what happened in"
    echo "[pre-push] PR #2314, and why there is an open GitHub ticket."
    echo ""
    echo "[pre-push] Replace the value with a reserved one:"
    echo "[pre-push]   emails  -> example.com / *.test  (RFC 2606)"
    echo "[pre-push]   phones  -> +1 <area> 555-01xx    (555-0100..555-0199)"
    echo "[pre-push] If the value IS invented, add it to FICTIONAL_NAMES in"
    echo "[pre-push] scripts/ci/check-fixture-pii.mjs -- never to the baseline."
    exit 1
  fi
fi

changed_files=$(echo "$all_files" | sed '/^$/d' | sort -u)

if [ -z "$changed_files" ]; then
  echo "[pre-push] No changed files in the pushed commits -- nothing to test."
  exit 0
fi

# --- Which pushed files sit in the type-check hole? (BACKLOG-2736) -----------
# `npm run type-check` is `tsc --noEmit` against tsconfig.json, whose `exclude`
# lists **/*.test.js|jsx|ts|tsx. A test file that does not compile is therefore
# INVISIBLE to it -- an engineer reported "npm run type-check clean" on a branch
# that did not build, because the error was in a test. tsconfig.test.json
# re-includes those files and CI runs it as its own step (ci.yml, "TypeScript
# type check (test suite)", BACKLOG-2414). Nothing ran it locally. That gap is
# this hook's, not tsc's.
#
# TWO conditions, and each answers a different question:
#   *.test.*  -- is the file IN the hole? (tsconfig.json excludes it, so no other
#                local gate reads it.)
#   the tree  -- can `tsc -p tsconfig.test.json` SEE it? That config includes
#                electron/**, src/**, tests/**, scripts/qa/harness/** and nothing
#                else. A changed broker-portal / admin-portal / android-companion
#                / e2e test is not in the command's file set, so running the
#                command would let a green line imply coverage it never had.
#                Those are NAMED as uncovered instead of silently swept in.
#                IF tsconfig.test.json's `include` LIST CHANGES, CHANGE THIS ONE.
#
# Derived from `changed_files` (the paths in the pushed commits) and deliberately
# NOT from what exists on disk: a commit that DELETES a test file still changes
# what the suite compiles, and an `[ -f ]` guard would skip exactly that push.
typecheck_tests=""
typecheck_tests_uncovered=""
for file in $changed_files; do
  case "$file" in
    *.snap) continue ;;   # snapshots are data; tsc never reads them
    *.test.*) ;;
    *) continue ;;
  esac
  case "$file" in
    electron/*|src/*|tests/*|scripts/qa/harness/*)
      typecheck_tests="$typecheck_tests $file"
      ;;
    *)
      typecheck_tests_uncovered="$typecheck_tests_uncovered $file"
      ;;
  esac
done
typecheck_tests=$(echo "$typecheck_tests" | sed 's/^ *//;s/ *$//')
typecheck_tests_uncovered=$(echo "$typecheck_tests_uncovered" | sed 's/^ *//;s/ *$//')

# Find related test files for changed .ts/.tsx source files
test_files=""
for file in $changed_files; do
  case "$file" in
    *.test.ts|*.test.tsx)
      # Changed file is itself a test — include it directly
      if [ -f "$file" ]; then
        test_files="$test_files $file"
      fi
      ;;
    *.ts|*.tsx)
      # Strip extension and check for corresponding test files
      base="${file%.*}"
      ext="${file##*.}"

      # Check <name>.test.ts / <name>.test.tsx
      for test_ext in ts tsx; do
        candidate="${base}.test.${test_ext}"
        if [ -f "$candidate" ]; then
          test_files="$test_files $candidate"
        fi
      done

      # Check __tests__/<filename>.test.ts / .test.tsx (same directory)
      dir=$(dirname "$file")
      filename=$(basename "$base")
      for test_ext in ts tsx; do
        candidate="${dir}/__tests__/${filename}.test.${test_ext}"
        if [ -f "$candidate" ]; then
          test_files="$test_files $candidate"
        fi
      done
      ;;
  esac
done

# Deduplicate and trim
test_files=$(echo "$test_files" | tr ' ' '\n' | sort -u | tr '\n' ' ' | sed 's/^ *//;s/ *$//')

# --- Pick the root-jest runner from the resting ABI ---------------------------
# Same probe as scripts/test-with-restore.js:125-136 (kept a copy rather than
# extracted: that function sits inside a load-bearing BACKLOG-2372 comment
# block, and refactoring it is not this task). The probe SELECTS a route; it
# never gates a skip, because both ABI states are real and each has a runner
# that works.
native_binary="$repo_root/node_modules/better-sqlite3-multiple-ciphers/build/Release/better_sqlite3.node"
abi_state=$(node -e '
  try {
    process.dlopen({ exports: {} }, process.argv[1]);
    console.log("node");
  } catch (e) {
    var m = (e && e.message) || "";
    console.log(/NODE_MODULE_VERSION|different Node\.js version/.test(m) ? "electron" : "unknown");
  }
' "$native_binary" 2>/dev/null || echo "unknown")

route="${PREPUSH_JEST_ROUTE:-auto}"
route_why=""
if [ "$route" = "auto" ]; then
  case "$abi_state" in
    electron)
      route="electron"
      route_why="native module rests on the Electron ABI"
      ;;
    node)
      route="node"
      route_why="native module is currently the Node build"
      ;;
    *)
      route="node"
      route_why="native module state could not be determined"
      banner "Could not determine which ABI the native SQLite module is built for." \
             "Looked at: $native_binary" \
             "Running root tests under plain node. If suites that use the real" \
             "SQLite driver fail with NODE_MODULE_VERSION, that is why -- the" \
             "failure is the environment, not your change. Re-check with:" \
             "  ELECTRON_RUN_AS_NODE=1 npx electron ./node_modules/jest/bin/jest.js <suite>"
      ;;
  esac
else
  route_why="PREPUSH_JEST_ROUTE=$route (override)"
fi

electron_bin=""
if [ "$route" = "electron" ]; then
  electron_bin="${PREPUSH_ELECTRON_BIN:-$(node -p "require('electron')" 2>/dev/null || true)}"
  if [ -z "$electron_bin" ] || [ ! -x "$electron_bin" ]; then
    banner "The Electron binary is not available, so real-SQLite suites cannot run on the correct ABI." \
           "Tried: ${electron_bin:-<unresolved>}" \
           "Running root tests under plain node instead. Suites that load the real" \
           "SQLite driver may fail for that reason alone." \
           "Repair (common in a fresh worktree):" \
           "  node node_modules/electron/install.js"
    route="node"
    route_why="electron binary unavailable"
    electron_bin=""
  fi
fi

# --- Report what was decided, every run --------------------------------------
# A hook that silently picks a scope is how the old bug survived for months.
echo "[pre-push] remote=$remote  commits=$total_commits  base=$base_desc"
echo "[pre-push] root jest route: $route ($route_why; probe=$abi_state)"
if [ -z "$test_files" ]; then
  echo "[pre-push] No affected test files found — skipping tests."
else
  echo "[pre-push] Affected tests:"
  for f in $test_files; do
    echo "  - $f"
  done
fi
if [ -n "$typecheck_tests" ]; then
  echo "[pre-push] test type-check: RUNNING npm run type-check:tests for:"
  for f in $typecheck_tests; do
    echo "  - $f"
  done
else
  echo "[pre-push] test type-check: SKIPPED (the pushed commits change no *.test.* file under electron/ src/ tests/ scripts/qa/harness/)"
fi
if [ -n "$typecheck_tests_uncovered" ]; then
  echo "[pre-push] test type-check: NOT covering these — outside tsconfig.test.json's include list:"
  for f in $typecheck_tests_uncovered; do
    echo "  - $f"
  done
fi

if [ -n "$PREPUSH_DRYRUN" ]; then
  echo "[pre-push] PREPUSH_DRYRUN=1 — decisions reported above, no tests executed."
  exit 0
fi

# --- Test-suite type check (BACKLOG-2736) ------------------------------------
# The SAME npm script CI runs in its "TypeScript type check (test suite)" step,
# with the SAME NODE_OPTIONS -- that step OOM'd (exit 134) at the runner's
# derived heap limit on PR #2212 and was pinned to 4096 MB (BACKLOG-2505,
# ci.yml). A hook that ran a nearby-but-different command could go green while
# CI went red, and a green that means something else is worse than no green.
#
# BEFORE jest, on purpose: a suite that does not compile is not worth executing,
# and this answers in ~17s where the suites can take minutes.
#
# COST, measured on this repo: 16.4-17.9s wall for the whole test tree, against
# the PII scan's 1.24-1.31s. It is far too slow to run unconditionally -- that is
# precisely why it is gated on the pushed test files. A push that touches none
# pays nothing beyond the string match above. BACKLOG-2573 rewrote this hook
# because the old one made --no-verify routine; a 17s tax on every push would
# rebuild that habit, so this stage must stay conditional.
#
# LIMIT, written down so nobody trusts it past its edge: the trigger is the
# pushed TEST files. A change to a SOURCE file that breaks the types of an
# UNCHANGED test file -- a renamed export, a narrowed signature -- does NOT fire
# this gate. CI runs the step unconditionally and still catches that shape. So a
# green hook is not the same statement as a green CI, and it is not meant to be.
# Widening the trigger to "any source file that has a related test" was
# considered and rejected: it puts 17s on ordinary pushes, i.e. it buys the CI
# result at the cost of the hook being bypassed.
#
# `if !` rather than a bare command: husky runs this file under `sh -e`, so an
# unguarded non-zero exit would kill the hook before it printed its own verdict.
if [ -n "$typecheck_tests" ]; then
  if ! NODE_OPTIONS="--max-old-space-size=4096" npm run type-check:tests; then
    echo ""
    echo "[pre-push] Test-suite type check failed. Push blocked."
    echo "[pre-push] These errors are INVISIBLE to 'npm run type-check': tsconfig.json"
    echo "[pre-push] excludes **/*.test.* , so a clean run there says NOTHING about the"
    echo "[pre-push] files listed above. Reproduce, and fix, with:"
    echo "[pre-push]   npm run type-check:tests"
    echo "[pre-push] CI runs the same step ('TypeScript type check (test suite)'), so"
    echo "[pre-push] without this stage the same failure would have arrived after the"
    echo "[pre-push] push instead of before it."
    exit 1
  fi
fi

if [ -z "$test_files" ]; then
  exit 0
fi

# Split test files into broker-portal, admin-portal, android-companion, and root
# tests. Broker-portal tests need their own jest config for correct @/ path
# resolution. Admin-portal tests are written for vitest and must be run with
# vitest. Android-companion tests import react-native / expo modules that the
# root jest (jsdom) config cannot transform — they must run from the companion
# dir under its own jest-expo config (BACKLOG-2224).
bp_tests=""
ap_tests=""
ac_tests=""
root_tests=""
for f in $test_files; do
  case "$f" in
    broker-portal/*)
      bp_tests="$bp_tests $f"
      ;;
    admin-portal/*)
      ap_tests="$ap_tests $f"
      ;;
    android-companion/*)
      ac_tests="$ac_tests $f"
      ;;
    *)
      root_tests="$root_tests $f"
      ;;
  esac
done

exit_code=0

# Run root tests (if any), on the runner the probe selected.
root_tests=$(echo "$root_tests" | sed 's/^ *//;s/ *$//')
if [ -n "$root_tests" ]; then
  if [ "$route" = "electron" ]; then
    ELECTRON_RUN_AS_NODE=1 "$electron_bin" "$repo_root/node_modules/jest/bin/jest.js" \
      --bail --no-coverage --passWithNoTests $root_tests || exit_code=$?
  else
    npx jest --bail --no-coverage --passWithNoTests $root_tests || exit_code=$?
  fi
fi

# Run broker-portal tests with broker-portal jest config (if any)
bp_tests=$(echo "$bp_tests" | sed 's/^ *//;s/ *$//')
if [ $exit_code -eq 0 ] && [ -n "$bp_tests" ]; then
  npx jest --config broker-portal/jest.config.js --bail --no-coverage --passWithNoTests $bp_tests || exit_code=$?
fi

# Run admin-portal tests via vitest (if any). Admin-portal tests import from
# 'vitest', not '@jest/globals', so Jest cannot parse them.
ap_tests=$(echo "$ap_tests" | sed 's/^ *//;s/ *$//')
if [ $exit_code -eq 0 ] && [ -n "$ap_tests" ]; then
  # Strip the admin-portal/ prefix since we cd into that directory
  ap_tests_rel=""
  for f in $ap_tests; do
    rel="${f#admin-portal/}"
    ap_tests_rel="$ap_tests_rel $rel"
  done
  ap_tests_rel=$(echo "$ap_tests_rel" | sed 's/^ *//;s/ *$//')
  (cd admin-portal && npx vitest run --passWithNoTests $ap_tests_rel) || exit_code=$?
fi

# Run android-companion tests with the companion jest config (jest-expo). Run
# from the android-companion dir so its own jest config applies and react-native
# / expo modules transform correctly (BACKLOG-2224).
ac_tests=$(echo "$ac_tests" | sed 's/^ *//;s/ *$//')
if [ $exit_code -eq 0 ] && [ -n "$ac_tests" ]; then
  # Strip the android-companion/ prefix since we cd into that directory
  ac_tests_rel=""
  for f in $ac_tests; do
    rel="${f#android-companion/}"
    ac_tests_rel="$ac_tests_rel $rel"
  done
  ac_tests_rel=$(echo "$ac_tests_rel" | sed 's/^ *//;s/ *$//')
  (cd android-companion && npx jest --bail --no-coverage --passWithNoTests $ac_tests_rel) || exit_code=$?
fi

if [ $exit_code -ne 0 ]; then
  echo ""
  echo "[pre-push] Tests failed. Push blocked."
  echo "[pre-push] Fix failing tests before pushing."
  exit 1
fi

echo "[pre-push] All affected tests passed."
exit 0
